# Copy to .env and fill in your values.

# Supabase: Project Settings → Database → Connection string (URI)
# Use "Session pooler" or "Direct connection". If direct fails, try pooler on port 6543.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

JWT_SECRET="change_this_to_a_long_random_secret"
PORT=5000
SESSION_SECRET="change_this_session_secret"

CORS_ORIGIN="http://localhost:3000"
FRONTEND_ORIGIN="http://localhost:3000"

# Production (Render) — set in Render dashboard → Environment
# FRONTEND_ORIGIN="https://civic-pulse-platform.vercel.app"
# CORS_ORIGIN="https://civic-pulse-platform.vercel.app"
# GOOGLE_REDIRECT_URL="https://civic-pulse-ak6s.onrender.com/api/auth/google/callback"
# RENDER_EXTERNAL_URL is set automatically by Render

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URL="http://localhost:5000/api/auth/google/callback"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
